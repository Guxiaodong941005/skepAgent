<?xml version="1.0" encoding="UTF-8"?>
<!--
  skepd — one daemon per Mac (ARCHITECTURE §3, §11), a LaunchDaemon.

  macOS has no ambient-capability equivalent, and a per-user LaunchAgent cannot setuid to
  the agent account, so this daemon runs as root from /Library/LaunchDaemons. Root is what
  lets it spawn the agent CLI as the restricted user named by the agent-user flag and chown the
  checkout to that user (PRD §11.4). It is otherwise the same outbound-only process (D18):
  no network listener, no socket in /tmp.

  The socket skepd creates is mode 0600 and owned by root, which the human's CLI cannot
  open. It needs to be 0660, group skep, with the human's account in that group (the
  original ARCHITECTURE §12 wording). Socket group and mode are not configurable yet
  (follow-up on the IPC server); until that lands, publish from the CLI's in-process
  fallback, which runs as the human and does not need the socket.

  Install (root):
    cp deploy/com.skepagent.skepd.plist /Library/LaunchDaemons/
    mkdir -p /var/lib/skep /var/lib/skep-roles/coding /Library/Logs/skep
    launchctl bootstrap system /Library/LaunchDaemons/com.skepagent.skepd.plist

  Provisioning (skep init, the trust root, the agent CLI) is in docs/RUNBOOK.md. Do not put
  provider credentials or GH_TOKEN in this plist (D19); a headless gh token, if this Mac is
  the one running gh, goes in the root daemon's own environment, not in the agent user's.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.skepagent.skepd</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/usr/local/lib/skep/skepd.js</string>
      <string>--home</string>
      <string>/var/lib/skep</string>
      <string>--role-dir</string>
      <string>/var/lib/skep-roles/coding</string>
      <string>--agent-user</string>
      <string>skep-agent</string>
      <string>--agent-home</string>
      <string>/Users/skep-agent</string>
      <string>--agent-path</string>
      <string>/usr/local/bin:/usr/bin</string>
    </array>

    <!-- State root, outside any user home. device.toml and the signing key live here. -->
    <key>WorkingDirectory</key>
    <string>/var/lib/skep</string>

    <!-- No GH_TOKEN and no provider variable (D19). See docs/RUNBOOK.md. -->
    <key>EnvironmentVariables</key>
    <dict>
      <key>SKEP_HOME</key>
      <string>/var/lib/skep</string>
    </dict>

    <!-- Runs as root: the only way this host can switch to the agent user. -->
    <key>UserName</key>
    <string>root</string>

    <!-- launchd keeps it running; throttling avoids a crash loop (PRD §10.6). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- stdout/stderr only. skepd opens no TCP socket. These files record whatever the -->
    <!-- process writes; skepd redacts only the content it writes itself (journals, -->
    <!-- notifications), not a crash trace launchd captures here. -->
    <key>StandardOutPath</key>
    <string>/Library/Logs/skep/skepd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/skep/skepd.err.log</string>
  </dict>
</plist>
