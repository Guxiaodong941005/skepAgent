# skepd — one daemon per Linux device (ARCHITECTURE §3, §11).
#
# The daemon is outbound-only (D18): it fetches the git remotes and, optionally, posts to an
# ntfy URL. It never listens on a network port. The CLI reaches it through the Unix socket at
# /var/lib/skep/skepd.sock (mode 0600, created by skepd itself).
#
# Install (paths are the packaged layout, not a checkout):
#   install -d -m 0755 /etc/skep /usr/local/lib/skep
#   install -m 0644 deploy/skepd.service /etc/systemd/system/skepd.service
#   install -m 0755 dist/bin/skepd.js /usr/local/lib/skep/skepd.js
#   systemctl daemon-reload && systemctl enable --now skepd.service
#
# State (device.toml, allowed_signers, the daemon signing key, the blackboard clone) lives in
# /var/lib/skep, mode 0700, owned by User=. Role directories live OUTSIDE that tree, at
# /var/lib/skep-roles/<role>, so the agent user can traverse them. See docs/RUNBOOK.md.

[Unit]
Description=Skep device daemon (signed git blackboard)
Documentation=https://example.invalid/skep/runbook
# Local filesystems only. A missing remote fails closed and the daemon retries (D18);
# blocking boot on the network would not make progress correct.
After=network.target
# Optional. Pull this in with a drop-in (systemctl edit skepd.service) when the host's
# network setup is slow and the first sync should wait for a configured route:
#   [Unit]
#   Wants=network-online.target
#   After=network-online.target
# Leave it unset on hosts where network-online.target never becomes ready.

[Service]
Type=simple
# Dedicated unprivileged user. The agent OS user is separate and named by --agent-user
# (PRD §11.4); it must not be this user, or the agent could read the signing key.
User=skep
Group=skep
# skepd starts as this user and then switches (PRD §11.4, src/bin/skepd.ts): it spawns the
# agent CLI with the agent uid/gid (CAP_SETUID, CAP_SETGID) and hands the checkout over with
# chown/lchown (CAP_CHOWN, src/exec/worktree.ts). Exactly these three, and no others: the
# bounding set drops everything else, and nothing here raises privileges further.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN
# State root. skepd resolves device.toml, the trust root, the lock and the socket under it
# (src/config/paths.ts). Never point this at a shared or agent-writable directory.
Environment=SKEP_HOME=/var/lib/skep
WorkingDirectory=/var/lib/skep
# No new privileges, and no ambient credentials (D19). Provider configuration lives in the
# agent user's own home; GH_TOKEN, when a headless gh needs it, is a code-host credential
# of this daemon user and is passed explicitly — see docs/RUNBOOK.md. It is not set here.
# Ambient capabilities stay available with NoNewPrivileges=true; it only stops the daemon
# from gaining privileges through a setuid binary.
NoNewPrivileges=true
# ProtectSystem=strict makes the tree read-only except the paths below. /etc/skep holds
# optional drop-ins (for example an explicit GH_TOKEN file); /var/lib/skep holds state.
# /var/lib/skep-roles is where worktrees are created, and /var/lib/skep-agent is the agent
# user's home, which the agent CLI must be able to write (its own local login, D19).
ProtectSystem=strict
# Hides /home and /root. An agent home under /home would be invisible to the subprocess
# that inherits this mount namespace, so the agent home stays under /var/lib (below).
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/skep /var/lib/skep-roles /var/lib/skep-agent /etc/skep
# The socket is created by skepd under SKEP_HOME; nothing here opens a port (D18).
UMask=0077
Restart=on-failure
RestartSec=5s
# SIGTERM stops the tick loop and releases the single-daemon lock (src/bin/skepd.ts).
KillSignal=SIGTERM
TimeoutStopSec=30s
# One slot in the MVP. Repeat --role-dir for a second role on this same device.
# --agent-path is the only PATH the agent subprocess receives; it is not this unit's PATH.
# The role directory is outside SKEP_HOME: the agent cannot traverse the 0700 state root.
ExecStart=/usr/bin/node /usr/local/lib/skep/skepd.js \
  --home /var/lib/skep \
  --role-dir /var/lib/skep-roles/coding \
  --agent-user skep-agent \
  --agent-home /var/lib/skep-agent \
  --agent-path /usr/local/bin:/usr/bin

[Install]
WantedBy=multi-user.target
